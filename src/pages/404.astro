---
import Base from "../layouts/Base.astro";
---
<Base title="Page not found — MotionBricks.wiki" description="The page you were looking for does not exist on this unofficial NVIDIA MotionBricks community guide." path="/404/">
  <section class="hero">
    <div class="wrap" style="text-align:center">
      <p class="eyebrow">404</p>
      <h1>This brick is not in the stack</h1>
      <p class="lede">The page you tried to reach does not exist or was moved. The guides are still where you left them:</p>
      <p style="margin-top:24px">
        <a class="btn" href="/">Back to the home page</a>
        <a class="btn ghost" style="margin-left:12px" href="/setup/">Go to the setup guide</a>
      </p>
    </div>
  </section>
</Base>
