---
import Base from "../layouts/Base.astro";
import Faq from "../components/Faq.astro";
import { OFFICIAL, RELATED, GIFS, PROJ_IMAGES } from "../data/site.js";

// Complete index of the official MotionBricks GIF gallery, grouped exactly as
// the README "Results" section. File names are the real paths under
// motionbricks/assets/gifs/ in the parent repo; sizes are NOT listed per file
// because the README only states they are muted ~10 s loops — never invent bytes.
const groups = [
  {
    id: "teasers",
    title: "Teasers",
    intro: "The two headline loops from the README Results section — animation and robotics side by side.",
    items: [
      { src: GIFS.teaserAnimation, file: "teaser_animation.gif", alt: "MotionBricks animation teaser: stylized characters generated in real time across varied styles", title: "Animation teaser", key: null },
      { src: GIFS.teaserRobotics, file: "teaser_robotics.gif", alt: "MotionBricks robotics teaser: Unitree G1 humanoid running generated whole-body motion", title: "Robotics teaser", key: null },
    ],
  },
  {
    id: "loco-single",
    title: "Smart locomotion — single styles",
    intro: "One primitive, one behaviour. Each loop is roughly ten seconds and muted; the same styles are playable in the interactive demo (keybinds where they exist).",
    items: [
      { src: GIFS.locoZombie, file: "loco_zombie.gif", alt: "G1 humanoid shuffling in a zombie-walk style generated by MotionBricks", title: "Zombie walk", key: "F" },
      { src: GIFS.locoInjuredLeg, file: "loco_injured_leg.gif", alt: "Humanoid limping with an injured leg, generated zero-shot", title: "Injured leg", key: "T" },
      { src: GIFS.locoInjuredTorso, file: "loco_injured_torso.gif", alt: "Humanoid moving with a hunched, injured-torso style", title: "Injured torso", key: null },
      { src: GIFS.locoSkipping, file: "loco_skipping.gif", alt: "Character skipping forward, generated in real time", title: "Skipping", key: null },
      { src: GIFS.locoStrafing, file: "loco_strafing.gif", alt: "Character strafing sideways while facing forward", title: "Strafing", key: null },
      { src: GIFS.locoCrouchStrafing, file: "loco_crouch_strafing.gif", alt: "Character strafing sideways in a crouched stealth posture", title: "Crouch strafing", key: "C" },
    ],
  },
  {
    id: "loco-mixture",
    title: "Smart locomotion — mixture of styles",
    intro: "Multiple primitives composed on the fly — the zero-shot mixture claim in motion.",
    items: [
      { src: GIFS.locoFreestyle, file: "loco_freestyle.gif", alt: "Character freely mixing locomotion styles with no visible blending seams", title: "Freestyle", key: null },
      { src: GIFS.locoIdleWalkJogRun, file: "loco_idle_walk_jog_run.gif", alt: "Idle to walk to jog to run speed ladder generated by one model", title: "Idle · Walk · Jog · Run", key: null },
    ],
  },
  {
    id: "objects",
    title: "Smart objects",
    intro: "Locomotion plus contact: picking things up, recovering from falls, jumping obstacles, sitting down.",
    items: [
      { src: GIFS.objPickupSword, file: "obj_pickup_sword.gif", alt: "Character bending down to pick up a sword from the ground", title: "Pick up sword", key: null },
      { src: GIFS.objFalling, file: "obj_falling.gif", alt: "Character falling and reacting to the ground", title: "Falling", key: null },
      { src: GIFS.objJumpBench, file: "obj_jump_bench.gif", alt: "Character vaulting over a park bench", title: "Jump over bench", key: null },
      { src: GIFS.objSitting, file: "obj_sitting.gif", alt: "Character sitting down on a bench", title: "Sitting", key: null },
      { src: GIFS.objInteractiveAuthoring, file: "obj_interactive_authoring.gif", alt: "Interactive authoring: a user placing and triggering object interactions live", title: "Interactive authoring", key: null },
    ],
  },
  {
    id: "related",
    title: "Related work teasers",
    intro: "The four sibling projects named in the README's Related Work section. They are not MotionBricks itself, but they share the repo and the GR00T story.",
    items: [
      { src: GIFS.kimodoTeaser, file: "kimodo_teaser.gif", alt: "Kimodo teaser: offline motion generation results", title: "Kimodo", key: null, link: RELATED.kimodoPage },
      { src: GIFS.sonicTeaser, file: "sonic_teaser.gif", alt: "GEAR-SONIC teaser: whole-body control on the G1 robot", title: "GEAR-SONIC", key: null, link: RELATED.sonicPage },
      { src: GIFS.bonesSeedTeaser, file: "bones_seed_teaser.gif", alt: "BONES-SEED dataset teaser: mocap clips from the training corpus", title: "BONES-SEED dataset", key: null, link: RELATED.bonesSeed },
      { src: GIFS.somaRetargeterTeaser, file: "soma_retargeter_teaser.gif", alt: "SOMA Retargeter teaser: capture retargeted onto the G1 skeleton", title: "SOMA Retargeter", key: null, link: RELATED.somaRetargeter },
    ],
  },
];

// interactive_demo.gif lives in the same gallery folder but is not under Results
// in the README — it illustrates the demo section. Listed honestly, separately.
const faqItems = [
  { q: "Where is the official MotionBricks icon or logo?", a: "NVIDIA does not ship a standalone icon file. The README badge image and the header art on the official project page (nvlabs.github.io/motionbricks) are the canonical brand assets, and the overview still teaser_image_motionbricks.jpg is hosted on that project page. This site links to them; it does not re-host them." },
  { q: "Where are the official MotionBricks GIFs hosted?", a: "In the NVlabs/GR00T-WholeBodyControl GitHub repository under motionbricks/assets/gifs/, tracked with Git LFS. The playable copies are served from media.githubusercontent.com/media/... — the raw.githubusercontent.com URL for the same path returns a ~1 KB LFS pointer file, not an image. All gallery images on this page embed the media domain directly." },
  { q: "How do I get the 4K MotionBricks demo video?", a: 'The full 4K runtime demo (about 1.2 GB, single .mp4) is hosted by NVIDIA at research.nvidia.com and linked directly from this page. The SIGGRAPH 2026 paper PDF is linked from the <a href="https://nvlabs.github.io/motionbricks/" rel="noopener">project page</a>. Downloading from NVIDIA\'s link requires no account; nothing is mirrored on this site.' },
];
---
<Base
  title="MotionBricks official assets: every GIF, the icon, and where they are hosted | MotionBricks.wiki"
  description="Complete index of NVIDIA's official MotionBricks GIF gallery (teasers, smart locomotion, smart objects, related work), the overview image and 4K demo video — plus the Git LFS media.githubusercontent trick for anyone hunting a working motionbricks icon or render source."
  path="/assets/"
  crumbs={[{ label: "Official assets", href: "/assets/" }]}
  ogImage={PROJ_IMAGES.overview}>
  <section class="hero">
    <div class="wrap">
      <p class="eyebrow">Asset index · sourced from the official repo and project page</p>
      <h1>Every official MotionBricks <span style="color:var(--accent)">GIF</span>, in one place</h1>
      <p class="lede">The README gallery, grouped the way NVIDIA grouped it: teasers, single locomotion styles, style mixtures, smart objects, and the related-work loops. Each image links back to the NVIDIA-hosted original — nothing on this site is a mirror or a re-host.</p>
    </div>
  </section>

  <section class="block wrap">
    <h2>The one fact that breaks most attempts</h2>
    <div class="warn">
      <strong>These GIFs are Git LFS objects.</strong> A URL like
      <code>raw.githubusercontent.com/NVlabs/GR00T-WholeBodyControl/main/motionbricks/assets/gifs/teaser_animation.gif</code>
      returns a ~1 KB LFS pointer file — valid text, not an image — which is why so many "motion bricks render" and icon links found online are broken embeds.
      The working image URL uses the media host instead:
      <code>media.githubusercontent.com/media/NVlabs/GR00T-WholeBodyControl/main/motionbricks/assets/gifs/&lt;file&gt;.gif</code>.
      Every <em>Open original</em> link on this page uses the media domain, and so do the <code>&lt;img&gt;</code> embeds.
    </div>
    <p>Same rule one level up: the parent repo skips MotionBricks checkpoints on a plain clone, so the <code>out/*.ckpt</code> files land as 1 KB pointers until <code>git lfs pull</code> runs (see <a href="/setup/">setup</a>).</p>
  </section>

  {groups.map((g) => (
    <section class="block wrap" id={g.id}>
      <h2>{g.title}</h2>
      <p>{g.intro}</p>
      <div class="gifgrid">
        {g.items.map((item) => (
          <figure>
            <img src={item.src} alt={item.alt} loading="lazy" width="640" height="360" />
            <figcaption>
              <strong>{item.title}</strong>
              {item.key && <> — playable in the <a href="/g1-demo/">G1 demo</a> with <span class="kbd">{item.key}</span></>}
              <br />
              <code>{item.file}</code> · official gallery loop, muted, ~10&nbsp;s (the README lists no per-file size) · <a href={item.src} rel="noopener">Open original</a>
            </figcaption>
          </figure>
        ))}
      </div>
    </section>
  ))}

  <section class="block wrap" id="video-stills">
    <h2>Video &amp; stills</h2>
    <p>Outside the GIF folder, the two big assets everyone searches for:</p>
    <ul>
      <li><strong>Overview still</strong> — <code>teaser_image_motionbricks.jpg</code>, the header art on the <a href={OFFICIAL.projectPage} rel="noopener">official project page</a> (the same file this site uses as its default social card). Hosted by NVIDIA, linked never copied.<figure style="max-width:720px"><img src={PROJ_IMAGES.overview} alt="MotionBricks overview still: side-by-side animation and robotics results generated by one model" loading="lazy" width="720" height="405" /></figure></li>
      <li><strong>4K runtime demo</strong> — <code>aibm_runtime_main_demo_latest_art_v3.mp4</code>, about 1.2 GB: <a href={OFFICIAL.demo4k} rel="noopener">download directly from research.nvidia.com</a>. The README points to the <a href={OFFICIAL.projectPage} rel="noopener">project page</a> for the full uncut demos and comparison videos.</li>
    </ul>
    <p>One more GIF sits in the same gallery folder but is not part of the Results section: <a href={GIFS.interactiveDemo} rel="noopener"><code>interactive_demo.gif</code></a> — the screencast of the keyboard demo, embedded on the <a href="/g1-demo/">G1 demo page</a>.</p>
  </section>

  <section class="block wrap">
    <h2>Using these assets legally</h2>
    <p>The repository is public; that is not the same as free-to-copy. Code is Apache 2.0, weights are under the NVIDIA Open Model License, and the README gives no separate image licence — so embed the NVIDIA-hosted URL (or the repo link) rather than re-uploading the files, and credit the source. This site follows that rule: <strong>every asset above is a hotlink to an NVIDIA-hosted file, and nothing is stored in this site's public folder.</strong></p>
  </section>

  <div class="wrap">
    <Faq items={faqItems} title="Assets FAQ" />
  </div>
</Base>
